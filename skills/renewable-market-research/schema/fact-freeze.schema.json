{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fact Freeze",
  "type": "object",
  "required": [
    "version",
    "slug",
    "generatedFrom",
    "canonicalFreezeId",
    "canonicalFactsHash",
    "factProfile",
    "requiredFactTypes",
    "conditionalFactTypes",
    "notApplicableFactTypes",
    "freezeId",
    "frozenAt",
    "basedOnLedgers",
    "facts"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "generatedFrom": {
      "description": "Compatibility projection source. Must reference canonical_facts.json.",
      "type": "string"
    },
    "canonicalFreezeId": {
      "type": "string"
    },
    "canonicalFactsHash": {
      "type": "string"
    },
    "factProfile": {
      "type": "string"
    },
    "requiredFactTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditionalFactTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notApplicableFactTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "freezeId": {
      "type": "string"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "frozenAt": {
      "type": "string"
    },
    "dataCutoff": {
      "type": [
        "string",
        "null"
      ]
    },
    "basedOnLedgers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "canonical-facts.schema.json#/$defs/canonicalFact"
      }
    },
    "chapterUseRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deprecatedValues": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "repairRouting": {
      "type": "object"
    }
  }
}
