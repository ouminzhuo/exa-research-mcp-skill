{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auction Ledger",
  "type": "object",
  "required": [
    "version",
    "slug",
    "auctions"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "auctions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "auctionId",
          "auctionRound",
          "auctionStatus",
          "officialAuctionTotalMW",
          "identifiableProjectCapacityMW",
          "unresolvedGapMW",
          "scope",
          "timeBasis",
          "allocationStatus",
          "projectIds",
          "sourceIds",
          "evidenceIds",
          "confidence"
        ],
        "properties": {
          "auctionId": {
            "type": "string"
          },
          "auctionRound": {
            "type": "string"
          },
          "auctionStatus": {
            "enum": [
              "announced",
              "open",
              "awarded",
              "cancelled",
              "paused",
              "not_applicable",
              "unknown"
            ]
          },
          "officialAuctionTotalMW": {
            "type": [
              "number",
              "null"
            ]
          },
          "identifiableProjectCapacityMW": {
            "type": [
              "number",
              "null"
            ]
          },
          "unresolvedGapMW": {
            "type": [
              "number",
              "null"
            ]
          },
          "valueStatus": {
            "enum": [
              "public",
              "estimated",
              "not_public",
              "not_applicable",
              "pending_verification",
              "unknown"
            ]
          },
          "displayValue": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": "string"
          },
          "timeBasis": {
            "type": "string"
          },
          "allocationStatus": {
            "enum": [
              "fully_identified",
              "partially_identified",
              "unresolved_gap",
              "not_applicable",
              "unknown"
            ]
          },
          "projectIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "pendingVerification": {
            "type": [
              "string",
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
