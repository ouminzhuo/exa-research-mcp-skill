{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-facts.schema.json",
  "title": "Canonical Facts",
  "type": "object",
  "required": [
    "version",
    "slug",
    "factProfile",
    "requiredFactTypes",
    "conditionalFactTypes",
    "notApplicableFactTypes",
    "freezeId",
    "frozenAt",
    "basedOnLedgers",
    "facts"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "factProfile": {
      "type": "string"
    },
    "requiredFactTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditionalFactTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notApplicableFactTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "freezeId": {
      "type": "string"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "frozenAt": {
      "type": "string"
    },
    "dataCutoff": {
      "type": [
        "string",
        "null"
      ]
    },
    "basedOnLedgers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/canonicalFact"
      }
    },
    "deprecatedValues": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "repairRouting": {
      "type": "object"
    }
  },
  "$defs": {
    "canonicalFact": {
      "type": "object",
      "required": [
        "factId",
        "factType",
        "statement",
        "value",
        "scope",
        "evidenceIds",
        "confidence",
        "frozenAt"
      ],
      "properties": {
        "factId": {
          "type": "string"
        },
        "factType": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "valueStatus": {
          "enum": [
            "public",
            "estimated",
            "not_public",
            "not_applicable",
            "pending_verification",
            "unknown"
          ]
        },
        "displayValue": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string"
        },
        "includedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "includedProjectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedProjectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusionBasis": {
          "type": [
            "array",
            "string",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "policyStatus": {
          "enum": [
            "enacted",
            "draft",
            "political_statement",
            "auction_allocation",
            "not_applicable",
            "unknown"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceTrace": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "pendingVerification": {
          "type": [
            "array",
            "string",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "frozenAt": {
          "type": "string"
        }
      }
    }
  }
}
