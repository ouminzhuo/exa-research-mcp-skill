{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V4 Project Ledger",
  "type": "object",
  "required": [
    "version",
    "slug",
    "projects"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "capacityReconciliation": {
      "type": "object",
      "required": [
        "confirmedCapacityMW",
        "opportunityCapacityMW",
        "watchlistCapacityMW",
        "excludedInactiveMW",
        "firmMW",
        "committedMW",
        "influencedMW",
        "unallocatedMW"
      ],
      "properties": {
        "officialAuctionTotalMW": {
          "type": [
            "number",
            "null"
          ]
        },
        "identifiableProjectCapacityMW": {
          "type": [
            "number",
            "null"
          ]
        },
        "confirmedCapacityMW": {
          "type": [
            "number",
            "null"
          ]
        },
        "opportunityCapacityMW": {
          "type": [
            "number",
            "null"
          ]
        },
        "watchlistCapacityMW": {
          "type": [
            "number",
            "null"
          ]
        },
        "suspendedOrPausedMW": {
          "type": [
            "number",
            "null"
          ]
        },
        "excludedInactiveMW": {
          "type": [
            "number",
            "null"
          ]
        },
        "firmMW": {
          "type": [
            "number",
            "null"
          ]
        },
        "committedMW": {
          "type": [
            "number",
            "null"
          ]
        },
        "influencedMW": {
          "type": [
            "number",
            "null"
          ]
        },
        "unallocatedMW": {
          "type": [
            "number",
            "null"
          ]
        },
        "calculationBasis": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "projectId",
          "aliasGroupId",
          "canonicalProjectName",
          "capacityMW",
          "opportunityMW",
          "developmentStage",
          "activityStatus",
          "ledgerTreatment",
          "projectCapacityTreatment",
          "oemCapacityTreatment",
          "capacityScope",
          "statusBasis",
          "countedInConfirmedCapacity",
          "countedInOpportunityCapacity",
          "sponsorOwner",
          "spv",
          "equityStructure",
          "oem",
          "oemRelationshipType",
          "oemRelationshipStatus",
          "procurementStatus",
          "turbineModel",
          "epc",
          "omParty",
          "financiers",
          "ppaOfftaker",
          "tariff",
          "codTimeline",
          "nextMilestone",
          "decisionMaker",
          "keyEvidence",
          "fieldConfidence",
          "pendingVerification",
          "mingyangRelevance",
          "mainRisks"
        ],
        "properties": {
          "projectId": {
            "type": "string"
          },
          "aliasGroupId": {
            "type": "string"
          },
          "canonicalProjectName": {
            "type": "string"
          },
          "projectAliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capacityMW": {
            "type": [
              "number",
              "null"
            ]
          },
          "opportunityMW": {
            "type": [
              "number",
              "null"
            ]
          },
          "bess": {
            "type": [
              "string",
              "object",
              "null"
            ]
          },
          "projectStage": {
            "description": "Legacy compatibility field only. New records must use developmentStage plus activityStatus.",
            "enum": [
              "operational",
              "partial_operation",
              "under_construction",
              "construction_ready",
              "financing_closed",
              "financial_close",
              "contracted",
              "auction_awarded",
              "permitted",
              "pre_auction",
              "early_development",
              "ppa_signed",
              "decree_backed",
              "tendering",
              "mou_jda",
              "watchlist",
              "duplicate",
              "rejected",
              "unresolved",
              "unavailable"
            ]
          },
          "developmentStage": {
            "enum": [
              "operational",
              "partial_operation",
              "under_construction",
              "construction_ready",
              "financial_close",
              "contracted",
              "auction_awarded",
              "permitted",
              "pre_auction",
              "early_development",
              "watchlist",
              "unverified"
            ]
          },
          "activityStatus": {
            "enum": [
              "active",
              "delayed",
              "paused",
              "withdrawn",
              "cancelled",
              "superseded",
              "unknown"
            ]
          },
          "ledgerTreatment": {
            "enum": [
              "confirmed",
              "watchlist",
              "duplicate",
              "rejected",
              "unresolved"
            ]
          },
          "projectCapacityTreatment": {
            "enum": [
              "confirmed_capacity",
              "opportunity_capacity",
              "watchlist_capacity",
              "excluded_inactive",
              "excluded_duplicate",
              "excluded_unverified",
              "policy_target_only",
              "auction_total_only"
            ]
          },
          "capacityTreatment": {
            "description": "Legacy compatibility alias only. New records must use projectCapacityTreatment.",
            "enum": [
              "confirmed_capacity",
              "opportunity_capacity",
              "watchlist_capacity",
              "excluded_inactive",
              "excluded_duplicate",
              "excluded_unverified",
              "policy_target_only",
              "auction_total_only"
            ]
          },
          "capacityScope": {
            "enum": [
              "official_auction_total",
              "identifiable_project_capacity",
              "confirmed_project_capacity",
              "opportunity_capacity",
              "watchlist_capacity",
              "suspended_or_paused_capacity",
              "national_policy_target",
              "draft_or_political_target",
              "unknown"
            ]
          },
          "statusBasis": {
            "type": "string"
          },
          "countedInConfirmedCapacity": {
            "type": "boolean"
          },
          "countedInOpportunityCapacity": {
            "type": "boolean"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "sponsorOwner": {
            "type": "string"
          },
          "spv": {
            "type": "string"
          },
          "equityStructure": {
            "type": "string"
          },
          "acquisitionRoute": {
            "type": [
              "string",
              "null"
            ]
          },
          "oem": {
            "type": "string"
          },
          "oemRelationshipType": {
            "enum": [
              "firm_supply_contract",
              "preferred_supplier",
              "conditional_reservation_or_cra",
              "framework_agreement",
              "technology_partnership",
              "reported_preference",
              "unallocated",
              "unknown"
            ]
          },
          "oemRelationshipStatus": {
            "enum": [
              "active",
              "conditional",
              "expired",
              "terminated",
              "superseded",
              "disputed",
              "unknown"
            ]
          },
          "oemCapacityTreatment": {
            "enum": [
              "firm_mw",
              "committed_mw",
              "influenced_mw",
              "unallocated_mw",
              "excluded_inactive_mw",
              "unknown"
            ]
          },
          "oemCapacityBucket": {
            "description": "Legacy compatibility alias only. New records must use oemCapacityTreatment.",
            "enum": [
              "firm_mw",
              "committed_mw",
              "influenced_mw",
              "unallocated_mw",
              "excluded_inactive_mw",
              "unknown"
            ]
          },
          "procurementStatus": {
            "enum": [
              "not_tendered",
              "rfq",
              "shortlisted",
              "awarded",
              "framework",
              "undisclosed",
              "pending_verification",
              "unavailable"
            ]
          },
          "turbineModel": {
            "type": "string"
          },
          "epc": {
            "type": "string"
          },
          "omParty": {
            "type": "string"
          },
          "financiers": {
            "type": [
              "array",
              "string"
            ],
            "items": {
              "type": "string"
            }
          },
          "ppaOfftaker": {
            "type": "string"
          },
          "tariff": {
            "type": "string"
          },
          "codTimeline": {
            "type": "string"
          },
          "nextMilestone": {
            "type": "string"
          },
          "decisionMaker": {
            "type": "string"
          },
          "influencers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keyEvidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fieldConfidence": {
            "type": "object"
          },
          "lastCheckedDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "pendingVerification": {
            "type": [
              "array",
              "string"
            ],
            "items": {
              "type": "string"
            }
          },
          "mingyangRelevance": {
            "enum": [
              "high",
              "medium",
              "low",
              "none",
              "pending"
            ]
          },
          "relevanceRationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "mainRisks": {
            "type": [
              "array",
              "string"
            ],
            "items": {
              "type": "string"
            }
          },
          "sourceTrace": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
