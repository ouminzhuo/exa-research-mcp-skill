{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric Ledger",
  "type": "object",
  "required": [
    "version",
    "slug",
    "metrics"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metricId",
          "label",
          "value",
          "unit",
          "scope",
          "timeBasis",
          "sourceIds",
          "confidence"
        ],
        "properties": {
          "metricId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "scopeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "timeBasis": {
            "type": "string"
          },
          "calculationBasis": {
            "type": [
              "string",
              "array",
              "object",
              "null"
            ]
          },
          "includedIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excludedIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "pendingVerification": {
            "type": [
              "string",
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
