{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy Target Ledger",
  "type": "object",
  "required": [
    "version",
    "slug",
    "targets"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "policyTargetId",
          "targetType",
          "value",
          "unit",
          "valueStatus",
          "displayValue",
          "scope",
          "timeBasis",
          "policyStatus",
          "sourceIds",
          "evidenceIds",
          "confidence"
        ],
        "properties": {
          "policyTargetId": {
            "type": "string"
          },
          "targetType": {
            "enum": [
              "enacted_policy_target",
              "draft_target",
              "political_statement_target",
              "auction_allocation",
              "not_applicable",
              "unknown"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "valueStatus": {
            "enum": [
              "public",
              "estimated",
              "not_public",
              "not_applicable",
              "pending_verification",
              "unknown"
            ]
          },
          "displayValue": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": "string"
          },
          "timeBasis": {
            "type": "string"
          },
          "policyStatus": {
            "enum": [
              "enacted",
              "draft",
              "political_statement",
              "not_applicable",
              "unknown"
            ]
          },
          "policyInstrument": {
            "type": [
              "string",
              "null"
            ]
          },
          "effectiveDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "pendingVerification": {
            "type": [
              "string",
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
